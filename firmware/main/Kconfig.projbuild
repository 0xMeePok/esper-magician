menu "Cheap Yellow Display"

    config CYD_LCD_PIXEL_CLOCK_MHZ
        int "SPI clock for the screen (MHz)"
        range 10 80
        default 40
        help
            40 MHz works on most boards. Drop to 20 if the picture is
            noisy or garbled.

    config CYD_LCD_BGR
        bool "Screen uses BGR colour order"
        default y
        help
            Turn this off if red and blue look swapped on the test card.

    config CYD_LCD_INVERT_COLORS
        bool "Invert colours"
        default n
        help
            Turn this on if the picture looks like a photo negative.
            Some newer "2 USB" boards need it.

    config CYD_LCD_MIRROR_X
        bool "Mirror the picture left to right"
        default y

    config CYD_LCD_MIRROR_Y
        bool "Mirror the picture top to bottom"
        default n

endmenu
